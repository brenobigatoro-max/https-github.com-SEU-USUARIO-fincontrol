<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.netbeans.org/ns/project/1">
    <type>org.netbeans.modules.ant.freeform</type>
    <configuration>
        <general-data xmlns="http://www.netbeans.org/ns/freeform-project/1">
            <name>FinControl</name>
            <properties>
                <property-file>nbproject/project.properties</property-file>
            </properties>
            <folders>
                <source-folder>
                    <label>Pacotes de código-fonte</label>
                    <type>java</type>
                    <location>${src.dir}</location>
                </source-folder>
                <build-folder><location>${build.dir}</location></build-folder>
                <build-folder><location>${dist.dir}</location></build-folder>
            </folders>
            <ide-actions>
                <action name="build"><target>jar</target></action>
                <action name="clean"><target>clean</target></action>
                <action name="rebuild"><target>clean</target><target>jar</target></action>
                <action name="run"><target>run</target></action>
            </ide-actions>
            <view>
                <items>
                    <source-folder style="packages">
                        <label>Pacotes de código-fonte</label>
                        <location>${src.dir}</location>
                    </source-folder>
                    <source-file><location>README.md</location></source-file>
                    <source-file><location>build.xml</location></source-file>
                    <source-file><location>db.properties.exemplo</location></source-file>
                    <source-file><location>sql/fincontrol.sql</location></source-file>
                </items>
                <context-menu>
                    <ide-action name="build"/>
                    <ide-action name="clean"/>
                    <ide-action name="rebuild"/>
                    <ide-action name="run"/>
                </context-menu>
            </view>
        </general-data>
        <java-data xmlns="http://www.netbeans.org/ns/freeform-project-java/5">
            <compilation-unit>
                <package-root>${src.dir}</package-root>
                <classpath mode="compile">lib/mysql-connector-j-8.4.0.jar</classpath>
                <built-to>${classes.dir}</built-to>
                <source-level>17</source-level>
            </compilation-unit>
        </java-data>
    </configuration>
</project>
